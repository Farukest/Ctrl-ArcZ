# The keeper's own key. Throwaway testnet key only — this process signs with it.
# Server-side only; it is never bundled into a client.
KEEPER_PK=0x...

# The keeper's salary box: a SpendPolicyAccount in PULL mode whose target is the
# keeper and whose vault is your wallet. Optional. Without it the keeper still
# reclaims, it just cannot refill itself and stops at its reserve.
# Create one with: pnpm --filter @ctrl-arcz/keeper exec tsx scripts/create-salary-box.ts
KEEPER_SALARY_BOX=
KEEPER_COSIGN_URL=http://127.0.0.1:8787/api/cosign

# Economics, as USDC amounts. Gas on Arc is USDC, so the keeper's operating cost
# and the money it rescues are the same unit.
KEEPER_GAS_PER_ACTION=0.005
KEEPER_RESERVE=0.20
KEEPER_LOW_WATER=0.50
KEEPER_TARGET_BALANCE=1.00

# Bounds. maxActions caps one tick; scanSpanBlocks keeps a failed tick from
# making the next request larger.
KEEPER_MAX_ACTIONS=5
KEEPER_MAX_READS=40
KEEPER_POLL_MS=60000
KEEPER_BACKFILL_BLOCKS=200000
KEEPER_SCAN_SPAN_BLOCKS=2000

# Decide and log, send nothing.
KEEPER_DRY_RUN=0
