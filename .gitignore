# throwaway test wallets, one-off probe scripts and the two-wallet browser builds.
# `.tmp-wallets.json` holds a private key in the clear and the `dist-<role>` copies
# inline a demo key into the JS bundle, so an accidental `git add -A` here would
# publish keys. Ignored by pattern, not by remembering to skip them.
.tmp-*
apps/*/dist-*/

# scratch
/tmp

# The bridge job store. Runtime state: transfer hashes and the addresses that
# authorised them, written wherever the API runs.
.bridge-jobs.json
.bridge-jobs.json.tmp
.circle-entity-recovery.txt
