{
  "name": "@ctrl-arcz/keeper",
  "version": "0.1.0",
  "description": "Ctrl+ArcZ keeper — an autonomous agent that returns expired unclaimed transfers to their senders, paid from its own on-chain-bounded spend box",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ctrl-arcz/sdk": "workspace:*",
    "dotenv": "^16.4.7",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
