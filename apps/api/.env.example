# Ctrl+ArcZ backend env. Copy to .env.local and fill in. NEVER commit real keys.
# All keys are server-only; they never reach a browser or an app bundle.

# Port the API listens on (behind nginx in production).
PORT=8787

# The enclave co-signer ("The Machine"). Signs Private Pay spends after the
# firewall + on-chain policy check. Throwaway testnet key only.
COSIGNER_PK=0x

# The demo relayer key that funds the CCTP/Gateway bridge and the gasless claim.
# Throwaway testnet key only.
RELAYER_PK=0x

# Circle Modular Wallets (gasless claim via Gas Station). Optional.
CIRCLE_CLIENT_KEY=
CIRCLE_CLIENT_URL=

# Comma-separated browser origins allowed to call the API (the web app). A native
# client sends no Origin header and is always allowed.
#
# Fail-closed: an empty list allows NO browser origin. It does not mean "any" --
# leaving this blank does not open the API up, it shuts every web app out with a
# 403, which is the safe direction to be wrong in.
#
# Running the apps locally means adding the local origin here too, or every
# relayer-funded flow answers 403 from a page that looks like it is working:
# CORS_ORIGINS=https://ctrlarcz.xyz,https://www.ctrlarcz.xyz,http://localhost:5173,http://localhost:5174
CORS_ORIGINS=https://ctrlarcz.xyz,https://www.ctrlarcz.xyz

# Enables the investigator (POST /api/investigate) — the reasoned second opinion
# on a recipient. Entirely optional: with no key the route still answers with the
# rule engine's verdict and a null advisory, and the app behaves as it does today.
ANTHROPIC_API_KEY=
